# ==============================================================================
# MyDiary Desktop - 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# [공동 개발자 및 기여자 안내]
# 본 프로젝트는 제로 컨피그(Zero-Config) Mock 환경을 완벽하게 지원합니다.
# GCP(Google Cloud) 키가 설정되지 않은 경우, 개발 모드에서 자동으로
# '가상(Mock) 구글 계정 및 가상 드라이브 스토리지'로 안전하게 동작합니다.
# 별도의 GCP 키 발급 없이도 즉시 앱을 실행하고 모든 기능을 테스트할 수 있습니다.
# ==============================================================================

# 1. Google OAuth 2.0 Desktop Client (실제 운영/연동 테스트 시 필요)
GOOGLE_CLIENT_ID=your_google_desktop_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 2. Mock 환경 제어 플래그 (선택 사항)
# true로 설정 시 실제 키가 있어도 강제로 가상(Mock) 구글 드라이브 모드로 실행합니다.
# VITE_USE_MOCK_GOOGLE=false

