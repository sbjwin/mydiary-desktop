{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "scripts/**/*",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron"
  ]
}
